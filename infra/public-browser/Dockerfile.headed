FROM mcr.microsoft.com/playwright:v1.63.0-noble@sha256:eff16c30e6f3f4af0a03fa4b706120d5e9b0891c344a27d64559aff5900a4a27

# Keep the headless image and runtime untouched. This is a distinct image
# variant for the reviewed headed profile. The pinned Playwright image supplies
# the exact Chromium build; the display, RFB server, and client assets are
# installed into this immutable image and require a rebuild to update.
USER root
COPY patch-novnc-raw.cjs /tmp/patch-novnc-raw.cjs
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      xvfb=2:21.1.12-1ubuntu1.6 \
      x11vnc=0.9.16-10 \
      novnc=1:1.3.0-2 \
 && test -d /usr/share/novnc \
 && install -d -o root -g root -m 0555 /opt/public-browser \
 && cp -a /usr/share/novnc /opt/public-browser/novnc \
 && node /tmp/patch-novnc-raw.cjs \
 && rm /tmp/patch-novnc-raw.cjs \
 && chmod -R a-w /opt/public-browser/novnc \
 && rm -rf /var/lib/apt/lists/*

COPY headed-entrypoint.sh /usr/local/bin/public-browser-headed-entrypoint
RUN chmod 0555 /usr/local/bin/public-browser-headed-entrypoint

USER pwuser
ENV DISPLAY=:99
ENTRYPOINT ["/usr/local/bin/public-browser-headed-entrypoint"]
